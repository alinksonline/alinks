# =============================================================================
# ALINKS local dev — NO DOCKER REQUIRED
# See LOCAL_DEV_SETUP.txt for Neon, Homebrew, or Supabase setup.
# Platform DB = Artix tenant/config only. Customer PII stays in tenant Sheets/BYO.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL (required) — pick ONE option
# -----------------------------------------------------------------------------

# Option A — Supabase platform project (recommended for ALINKS production)
# Dashboard → Project Settings → Database → Connect → Connection string
#
# Prefer "Session pooler" (IPv4). Direct "db.xxx.supabase.co" is often IPv6-only
# and causes: getaddrinfo ENOTFOUND db.YOUR_REF.supabase.co on many networks.
#
# - URL-encode password special chars (@ → %40, # → %23)
# - Username is postgres.YOUR_PROJECT_REF (note the dot)
# - Host is often aws-1-<region>.pooler.supabase.com (copy from dashboard — region varies)
#
# Session mode (port 5432) — best for app + drizzle migrate:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
#
# Transaction mode (port 6543) — optional for high-concurrency serverless:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
#
# Avoid unless you have IPv6 everywhere:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Option B — Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/alinks_platform?sslmode=require

# Option C — Homebrew Postgres on Mac only:
# DATABASE_URL=postgresql://alinks_user@localhost:5432/alinks_platform

DATABASE_URL=

# After setting DATABASE_URL for the first time:
#   npm run db:migrate
#   npm run db:seed

# -----------------------------------------------------------------------------
# Google Sheets (tenant customer data — orders, bookings, clients/patients)
# -----------------------------------------------------------------------------
# 1. Google Cloud → enable Sheets API + Drive API
# 2. Create service account → download JSON key
# 3. Paste entire JSON as one line (escape newlines as \n in private_key)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}
#
# 4. Leave STORAGE_DEV_MODE unset/false for live Sheets. true = local .data/tenant-sheets JSON only
# STORAGE_DEV_MODE=false
#
# 5. Optional: protect /api/storage/process-queue for retries
# CRON_SECRET=long-random-string

# Bootstrap seed only: phone used when seeding the superadmin DB row (tenants.role = superadmin).
# Login no longer elevates by email/phone env — role is read from tenants.role.
SUPERADMIN_PHONE=9999999999

# Dev OTP bypass (never use in production; remove from Vercel Production when live SMS/email is solid)
DEV_OTP=1111

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_HOST=app.localhost:3000
NEXT_PUBLIC_MARKETING_HOST=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Redis — Upstash REST API (not redis-cli TCP URL)
# Upstash Console → database → REST API tab (NOT the redis:// :6379 endpoint)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Auth — Email OTP (free, recommended): https://resend.com → API Keys
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=ALINKS <onboarding@alinks.online>  ← domain must be verified in Resend
# SUPERADMIN_EMAIL=you@gmail.com                     ← optional superadmin by email

# Auth — Google sign-in (optional): Google Cloud Console → OAuth client
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Callback URL: https://alinks.online/api/auth/google/callback

# MSG91 OTP — Widget mode (production SMS): OTP → Create Widget → Web SDK Custom UI
# NEXT_PUBLIC_MSG91_WIDGET_ID=
# NEXT_PUBLIC_MSG91_WIDGET_TOKEN=   ← Widget Auth Token (not API Auth Key)
# MSG91_AUTH_KEY=                 ← Server only — verifyAccessToken

# MSG91 OTP — Direct API fallback (if widget vars not set):
# MSG91_OTP_TEMPLATE_ID=    ← OTP → Templates → ALINKS_Signup_OTP
# MSG91_SENDER_ID=ALINKS

# Razorpay Standard Checkout (live keys in .env — backup in .secrets/razorpay-live.env)
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=...
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx   # KEY_ID only — safe for browser

# CodeRabbit CLI — Agentic API key only (NOT User API key)
# Create at: https://app.coderabbit.ai/settings/api-keys
# CODERABBIT_API_KEY=cr-...
# Media / images (WebP pipeline)
# Production: Vercel → Storage → Blob → create store → BLOB_READ_WRITE_TOKEN
# Without token, local dev writes to public/uploads (ok for laptop; not for multi-instance prod)
# BLOB_READ_WRITE_TOKEN=
